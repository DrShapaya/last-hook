shader_type spatial; render_mode unshaded, cull_disabled, blend_mix, depth_draw_never, shadows_disabled; varying vec2 place; void vertex(){ place=MODEL_MATRIX[3].xy; } void fragment(){ vec2 p=vec2(UV.x*2.0-1.0,1.0-UV.y*2.0); if(p.y<0.0){ p.y*=1.7; } float a=atan(p.y,p.x); float s=place.x*1.3+place.y*.7; float d=length(p)/.76+sin(a*3.0+s)*.055+sin(a*5.0+s*1.7)*.04; ALBEDO=mix(vec3(.21,.105,.05),vec3(.022,.013,.009),smoothstep(.99,.62,d))+vec3(.055,.028,.012)*smoothstep(-.25,-.95,p.y); ALPHA=smoothstep(1.0,.94,d)*.93; }