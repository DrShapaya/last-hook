shader_type spatial; render_mode unshaded, cull_disabled, blend_mix, depth_draw_never, shadows_disabled; varying vec2 place; void vertex(){ place=MODEL_MATRIX[3].xy; } void fragment(){ vec2 p=vec2(UV.x*2.0-1.0,1.0-UV.y*2.0); if(p.y<0.0){ p.y*=1.7; } float a=atan(p.y,p.x); float s=place.x*1.3+place.y*.7; float d=length(p)/.76+sin(a*3.0+s)*.055+sin(a*5.0+s*1.7)*.04; ALBEDO=mix(vec3(.16,.075,.035),vec3(.012,.008,.006),smoothstep(.95,.55,d)); ALPHA=smoothstep(1.02,.78,d)*.98; }