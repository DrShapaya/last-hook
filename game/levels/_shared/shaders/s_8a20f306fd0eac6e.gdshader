shader_type spatial; render_mode cull_disabled; uniform sampler2D albedo_tex : source_color, filter_linear_mipmap, repeat_disable; uniform vec4 tint : source_color = vec4(1.0); uniform float hanging = 0.0; uniform float sway = .06; uniform float wind = 1.0; uniform float contact = .42; void vertex(){ float w = hanging > .5 ? UV.y : 1.0-UV.y; w *= w; float phase = MODEL_MATRIX[3].x*.9 + MODEL_MATRIX[3].y*.37; VERTEX.x += sin(TIME*1.5+phase)*sway*w*wind; VERTEX.z += cos(TIME*1.1+phase)*sway*.3*w*wind; } void fragment(){ vec4 c = texture(albedo_tex, UV); float root = hanging > .5 ? smoothstep(.22, .0, UV.y) : smoothstep(.72, 1.0, UV.y); vec3 col = c.rgb*tint.rgb; float grey = dot(col, vec3(.299,.587,.114)); col = mix(vec3(grey), col, .88)*vec3(.93,.95,.98); col *= 1.0-root*contact; ALBEDO = col; ALPHA = c.a; ALPHA_SCISSOR_THRESHOLD = .5; ROUGHNESS = .9; NORMAL = FRONT_FACING ? NORMAL : -NORMAL; }