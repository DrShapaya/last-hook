shader_type spatial; render_mode cull_disabled; uniform sampler2D mask : source_color, filter_linear_mipmap, repeat_disable; uniform vec4 cloth_color : source_color = vec4(.85,.3,.25,1.0); uniform vec4 trim_color : source_color = vec4(.93,.74,.3,1.0); uniform float hang = 0.0; uniform float wind = 1.0; void vertex(){ float free = hang > .5 ? UV.y : UV.x; float phase = MODEL_MATRIX[3].x*.8 + MODEL_MATRIX[3].y*.5; float wave = sin(TIME*3.2 - free*6.0 + phase)*.07*free + sin(TIME*5.1 - free*11.0 + phase)*.015*free; VERTEX.z += wave*wind; VERTEX.y += (1.0-hang)*sin(TIME*2.3 - free*4.0 + phase)*.02*free*wind; } void fragment(){ vec4 m = texture(mask, UV); vec3 base = cloth_color.rgb*m.r; vec3 deep = cloth_color.rgb*.42*m.r; vec3 trim = trim_color.rgb*mix(.75,1.05,m.r); vec3 c = mix(base, deep, m.b); c = mix(c, trim, m.g); ALBEDO = c; ALPHA = m.a; ALPHA_SCISSOR_THRESHOLD = .5; ROUGHNESS = .88; NORMAL = FRONT_FACING ? NORMAL : -NORMAL; }