shader_type spatial; render_mode unshaded, cull_disabled, blend_mix, depth_draw_never, shadows_disabled; uniform vec4 tint : source_color = vec4(1.0); uniform float strength = .3; uniform float speed = 1.0; uniform float seed = 0.0; void fragment(){ float dash = smoothstep(.0,.25,fract(UV.x*1.6-TIME*speed+seed))*smoothstep(1.0,.55,fract(UV.x*1.6-TIME*speed+seed)); float edge = smoothstep(0.0,.5,UV.y)*smoothstep(1.0,.5,UV.y); ALBEDO = tint.rgb; ALPHA = dash*edge*strength*tint.a; }